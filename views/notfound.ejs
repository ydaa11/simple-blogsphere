<!DOCTYPE html>
<html>
<head>
    <title>Page Not Found</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background-color:#f8e8ff;
            font-family:"Times New Roman", Times, serif;
            display:flex;
            justify-content:center;
            align-items:center;
            height:100vh;
        }

        .box{
            background:#ffd6e8;
            padding:40px;
            border-radius:20px;
            text-align:center;
            box-shadow:0 4px 10px rgba(0,0,0,0.1);
        }

        h1{
            color:#8e44ad;
            font-size:60px;
        }

        p{
            color:#5e3370;
            font-size:20px;
        }

        .btn{
            background:#c084fc;
            border:none;
            color:white;
            margin-top:15px;
        }
    </style>
</head>
<body>

<div class="box">
    <h1>404</h1>

    <p>Page Not Found</p>

    <a href="/posts" class="btn btn-primary">
        Back to Homepage
    </a>
</div>

</body>
</html>